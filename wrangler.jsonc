{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pastebin-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
